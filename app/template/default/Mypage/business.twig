{% extends 'default_frame.twig' %}

{% set mypageno = 'business' %}

{% set body_class = 'mypage_business' %}

{% set defBasePrice = 2000 %}

{% block stylesheet %}
<style type="text/css">
    button {
        background: #ccc;
        border: solid 2px #aaa;
        border-radius: 5px;
        width: 50px;
    }
    button:hover {
        background: #fff;
    }
    button:active {
        background: #aaa;
    }
</style>
{% endblock stylesheet %}

{% block javascript %}
<script>
    $(function () {
      let timeMinutes = 120;                  // 初期値 2:00 → 120分
      let basePrice = $("#basePrice").text(); // 1時間あたりの料金
      let staffFare = $("#staffFare").text();      // 交通費

      function updateDisplay() {
        // 時間表示（mm → hh:mm）
        let hours = Math.floor(timeMinutes / 60);
        let minutes = timeMinutes % 60;
        let timeText = hours + ":" + (minutes === 0 ? "00" : minutes);
        $("#time").text(timeText);

        // 合計計算
        let total = basePrice * (timeMinutes / 60) + Number(staffFare);
        $("#total").text(Math.floor(total).toLocaleString());
      }

      // ＋ボタン
      $("#plus").on("click", function () {
        timeMinutes += 15;
        updateDisplay();
      });

      // －ボタン
      $("#minus").on("click", function () {
        if (timeMinutes > 30) {
          timeMinutes -= 15;
          updateDisplay();
        }
      });

      // 初期表示
      updateDisplay();
    });

</script>
{% endblock javascript %}

{% block main %}
    <div class="ec-layoutRole__main">
        <div class="ec-mypageRole">
            <div class="ec-pageHeader">
                <h1>{{ 'front.mypage.title'|trans }}/{{ 'front.mypage.nav.business'|trans }}</h1>
            </div>
            {% include 'Mypage/navi.twig' %}
        </div>

        {% set remessage = false %}

        {% for row in Business %}
            {% set BusinessStaff = repository('Customize\\Entity\\BusinessStaff').findOneBy({'Business':row}) %}

            <div class="ec-orderRole">
                <div class="ec-orderRole__detail">
                    <div class="ec-orderDelivery">
                        <div class="ec-rectHeading">
                            <h2>{{ 'front.mypage.nav.business'|trans }}{% if loop.index > 1 %}［{{ loop.index }}］{% endif %}</h2>
                    </div>
                    <div class="ec-definitions">
                        <dt>ご契約日：</dt>
                        <dd></dd>
                    </div>
                    <div class="ec-definitions">
                        <dt>契約形態：</dt>
                        <dd>
                            {{ row.contractor_id is empty ? '' : BusinessConstractors[row.contractor_id] }}
                        </dd>
                    </div>
                    <div class="ec-definitions">
                        <dt>契約種類：</dt>
                        <dd>
                            {{ row.kind_id is empty ? '' : BusinessKinds[row.kind_id] }}
                        </dd>
                    </div>
                    <div class="ec-definitions">
                        <dt>契約状況：</dt>
                        <dd>{{ row.status }}</dd>
                    </div>
                    <div class="ec-definitions">
                        <dt style='vertical-align:top;'>ご契約詳細：</dt>
                        <dd>
                            <p>
                        {% if BusinessStaff %}
                            {% set Weekly = ['日','月','火','水','木','金','土'] %}
                            {% set StaffWork = repository('Customize\\Entity\\BusinessStaffWorkingTime').findBy({'Business':row, 'Staff':BusinessStaff}
                                                                                                                ,{'day_of_week':'ASC'}) %}
                            {% for work in StaffWork %}
                                * {{ Weekly[work.day_of_week] }}曜日: {{ work.working_time_start}} - {{ work.working_time_end}}<br>
                            {% endfor%}
                        {% endif %}
                            </p>
                        </dd>
                    </div>
                    <div class="ec-definitions">
                        <dt>お支払い方法：</dt>
                        <dd>{% if Customer.payment_type %}{{ PaymentType[Customer.payment_type] }}{% endif %}</dd>
                    </div>
                    <div class="ec-definitions">
                        <dt>担当スタッフ：</dt>
                        <dd>
                        {% if BusinessStaff %}
                            {{ BusinessStaff.Staff.name01 }} {{ BusinessStaff.Staff.name02 }}
                        {% endif %}
                        </dd>
                    </div>
                </div>
{#
                <div class="ec-orderPayment">
                    <div class="ec-rectHeading">
                        <h2>{{ 'front.mypage.payment_info'|trans }}</h2>
                    </div>
                    <div class="ec-definitions">
                        <dt>お支払い方法</dt>
                        <dd>--</dd>
                    </div>
                </div>
#}
            </div>
            {% if loop.index == 1 %}
            <div class="ec-orderRole__summary">
                <div class="ec-totalBox">
                    <dl class="ec-totalBox__spec">
                        <dt>基本料金</dt>
                        <dd>
                            <span id="basePrice">{{ BusinessPlan ? BusinessPlan.basic_time_bill : defBasePrice }}</span>円
                        </dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt>ご利用時間</dt>
                        <dd>
                            <span id="time">2:00</span>
                        </dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt>&nbsp;</dt>
                        <dd>
                            <button id="plus"　class='btn_plus'>+</button>
                            <button id="minus"　class='btn_minus'>-</button>
                        </dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt>スタッフ交通費</dt>
                        <dd>
                            <span id="staffFare">{{ BusinessStaff ? BusinessStaff.fare : 0}}</span>円<br>
                        </dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt></dt>
                        <dd>
                            <span class="ec-totalBox__taxLabel">{{ BusinessStaff ? BusinessStaff.access : ''}}</span>
                        </dd>
                    </dl>
                    <div class="ec-totalBox__paymentTotal">{{ 'common.total'|trans }}
                        <span id="total" class="ec-totalBox__price"></span>円
                        <span class="ec-totalBox__taxLabel">{{ 'common.tax_include'|trans }}</span>
                    </div>
                </div>
                <p class="ec-color-accent">
                    <strong>
                    ＜応援券アプリでのお支払い＞<br>
                        ご利用方法はこちらをご確認ください。
                    </strong>
                    <dl style="font-size:small; padding-top:10px">
                    <dd>※アプリでのご決済は、可能であればご利用日の当日中、難しい場合はご利用月内にお願いいたします。</dd>
                    </dl>
                </p>
            </div>
            {% endif %}
        </div>
        {% endfor %}

        <div class="ec-role ec-orderRole">
            <div class="ec-orderRole__detail">
                <a href="{{ url('mypage') }}" class="ec-inlineBtn ec-font-bold">{{ 'common.back'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
