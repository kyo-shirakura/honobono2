<!doctype html>
<html lang="{{ eccube_config.locale }}">
<head prefix="og: https://ogp.me/ns# fb: https://ogp.me/ns/fb# product: https://ogp.me/ns/product#">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="eccube-csrf-token" content="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
    <title>{{ BaseInfo.shop_name }}{% if subtitle is defined and subtitle is not empty %} / {{ subtitle }}{% elseif title is defined and title is not empty %} / {{ title }}{% endif %}</title>
    {% if Page.meta_tags is not empty %}
        {{ include(template_from_string(Page.meta_tags), sandboxed = true) }}
        {% if Page.description is not empty %}
            <meta name="description" content="{{ Page.description }}">
        {% endif %}
    {% else %}
        {{ include('meta.twig') }}
    {% endif %}
    {% if Page.author is not empty %}
        <meta name="author" content="{{ Page.author }}">
    {% endif %}
    {% if Page.keyword is not empty %}
        <meta name="keywords" content="{{ Page.keyword }}">
    {% endif %}
    {% if Page.meta_robots is not empty %}
        <meta name="robots" content="{{ Page.meta_robots }}">
    {% endif %}
    <link rel="icon" href="{{ asset('assets/img/common/favicon.ico', 'user_data') }}">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.5.2/css/all.css" integrity="sha384-PPIZEGYM1v8zp5Py7UjFb79S58UeqCL9pYVnVPURKEqvioPROaVAJKKLzvH2rDnI" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    <script src="{{ asset('front.bundle.js', 'bundle') }}"></script>
    <style type="text/css">
        h2.main {
            margin-bottom: 30px;
            font-size: 1;
            text-align: center;
        }
        div.logo {
            margin: 10px 30px;
        }
        div.main-image img {
            width: 100%;
        }
        div.t-line {
            border-top: 1px dotted #ccc;
            padding-top: 10px;
        }
        div.b-line {
            border-bottom: 1px dotted #ccc;
            padding-bottom: 10px;
        }
        span.annotation {
            color: #f00;
        }

        {% if body_class is defined and body_class == 'staffpage' %}
        .error {
            border: solid 2px;
            border-color: red;
        }
        @media screen and (max-width: 480px) {
    	/* 480px以下に適用されるCSS（スマホ用） */
            div.row {
                display: block;
            }
            div.col-4 {
                width: auto;
            }
            div.working_time {
                display: flex;
            }
        }
        @media screen and (min-width: 768px) {
            /* 768px以上に適用されるCSS（PC用） */
            div.ec-grid2__cell {
                margin-left: 25%;
            }
        }
        div.block_payment_advance {
            display: none;
        }
        div.block_payment_receipt {
            display: none;
        }
        {% endif %}

    </style>
    <script>
        $(function() {
            $.ajaxSetup({
                'headers': {
                    'ECCUBE-CSRF-TOKEN': $('meta[name="eccube-csrf-token"]').attr('content')
                }
            });
        });

        {% if body_class is defined and body_class == 'staffpage' %}
        // 業務報告
        $(function() {
            $('#working_time_total_disp').text('0:00');
            // 合計時間を算出
            $('#working_time_start_hour').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_start_minute').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_end_hour').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_end_minute').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_break').on('change', function() {
                working_time_total_calc();
            });
            // 未精算がある場合
            $('#payment').on('change', function() {
                var checked = $(this).prop('checked');
                if (checked) {
                    //$('input[id^="check_"]').prop('checked', true);
                    $('.block_payment_advance').show();
                    $('.block_payment_receipt').show();
                    //$('.block_payment_advance').css('display', 'flex');
                    //$('.block_payment_receipt').css('display', 'flex');
                } else {
                    //$('input[id^="check_"]').prop('checked', false);
                    $('.block_payment_advance').hide();
                    $('.block_payment_receipt').hide();
                }
            });
            // バリデーション
            $('#form1').on('submit', function() {
                if ( $('#Business').val() == '' ){
                    $('#Business').addClass('error');
                    $('#Business').focus();
                    return false;
                }
            });
            $('#Business').on('click', function() {
                $('#Business').removeClass('error');
            });

        });
        // 合計時間
        function working_time_total_calc(){
            var timetotal = '00:00';
            if(
                !$('#working_time_start_hour').length
                || !$('#working_time_start_minute').length
                || !$('#working_time_end_hour').length
                || !$('#working_time_end_minute').length
                || !$('#working_time_break').length
            ){
            }else{
                const tday = "2024/01/01";
                const starttime = $('#working_time_start_hour').val() + ':' + $('#working_time_start_minute').val();
                const endtime = $('#working_time_end_hour').val() + ':' + $('#working_time_end_minute').val();
                const breakminute = $('#working_time_break').val();
                const breaktime = `${Math.floor(breakminute / 60)}:${ breakminute % 60 }`;

                let date1 = new Date(`${tday} ${starttime}`);
                let date2 = new Date(`${tday} ${endtime}`);
                let date3 = breakminute * 60000;
                let ms = date2 - date1 - date3;
//                var diff = date2.getTime() - date1.getTime();
//                console.log(diff / (60*60*1000)); // 48
                if ( ms < 0 ){ return; }

                const hour = Math.floor(ms / 3600000);
                const minute = Math.floor((ms - 3600000 * hour) / 60000);
                const hh = ("00" + hour).slice(-2);
                const mm = ("00" + minute).slice(-2);
                timetotal = hh + ':' + mm;
            }
            $('#working_time_total').val(timetotal);
            $('#working_time_total_disp').text(timetotal);
        }

        {% endif %}
    </script>
    {# Layout: HEAD #}
    {% if Layout.Head %}
        {{ include('block.twig', {'Blocks': Layout.Head}) }}
    {% endif %}
    {# プラグイン用styleseetやmetatagなど #}
    {% if plugin_assets is defined %}{{ include('@admin/snippet.twig', { snippets: plugin_assets }) }}{% endif %}
    <link rel="stylesheet" href="{{ asset('assets/css/customize.css', 'user_data') }}">
</head>

<body id="page_{{ app.request.get('_route') }}" class="{{ body_class|default('other_page') }}">
    <div class="ec-layoutRole">

        <header>
            <div class="container">
                <div class="logo">
                    <div class="row-fluid">
<!--
                        <div class="span6"><img src="https://www.honobono-vision.com/img/vision_2.png" alt="ほのぼのビジョン・システムズ"></div>
-->
                    </div>
                </div>
                <h2 class="main">{{ 'common.system.title'|trans }}</h2>
                <div class="main-image">
                    <div class="row-fluid">
<!--
                        <div class="span6"><img src="https://www.honobono-vision.com/img/bg_illust.png" alt="ほのぼのビジョン"></div>
-->
                    </div>
                </div>
            </div>
        </header>

{% if app.request.get('_route') != 'homepage_' %}

        {# Layout: CONTENTS_TOP #}
        {% if Layout.ContentsTop %}
            <div class="ec-layoutRole__contentTop">
                {{ include('block.twig', {'Blocks': Layout.ContentsTop}) }}
            </div>
        {% endif %}

        <div class="ec-layoutRole__contents">
            {# Layout: SIDE_LEFT #}
            {% if Layout.SideLeft %}
                <aside class="ec-layoutRole__left">
                    {{ include('block.twig', {'Blocks': Layout.SideLeft}) }}
                </aside>
            {% endif %}

            {% set layoutRoleMain = 'ec-layoutRole__main' %}
            {% if Layout.ColumnNum == 2 %}
                {% set layoutRoleMain = 'ec-layoutRole__mainWithColumn' %}
            {% elseif Layout.ColumnNum == 3 %}
                {% set layoutRoleMain = 'ec-layoutRole__mainBetweenColumn' %}
            {% endif %}

            <main class="{{ layoutRoleMain }}">
                {# Layout: MAIN_TOP #}
                {% if Layout.MainTop %}
                    <div class="ec-layoutRole__mainTop">
                        {{ include('block.twig', {'Blocks': Layout.MainTop}) }}
                    </div>
                {% endif %}

                {# MAIN AREA #}
                {% block main %}{% endblock %}

                {# Layout: MAIN_Bottom #}
                {% if Layout.MainBottom %}
                    <div class="ec-layoutRole__mainBottom">
                        {{ include('block.twig', {'Blocks': Layout.MainBottom}) }}
                    </div>
                {% endif %}
            </main>

            {# Layout: SIDE_RIGHT #}
            {% if Layout.SideRight %}
                <aside class="ec-layoutRole__right">
                    {{ include('block.twig', {'Blocks': Layout.SideRight}) }}
                </aside>
            {% endif %}
        </div>

        {# Layout: CONTENTS_BOTTOM #}
        {% if Layout.ContentsBottom %}
            <div class="ec-layoutRole__contentBottom">
                {{ include('block.twig', {'Blocks': Layout.ContentsBottom}) }}
            </div>
        {% endif %}

        {# Layout: CONTENTS_FOOTER #}
        {% if Layout.Footer %}
            <footer class="ec-layoutRole__footer">
                {{ include('block.twig', {'Blocks': Layout.Footer}) }}
            </footer>
        {% endif %}

{% endif %}
    </div><!-- ec-layoutRole -->

</body>
</html>
