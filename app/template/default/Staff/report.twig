        text-align: center;
    }
    div.logo {
        margin: 10px 30px;
    }
    div.main-image img {
        width: 100%;
    }
    div.t-line {
        border-top: 1px dotted #ccc;
        padding-top: 10px;
    }
    div.b-line {
        border-bottom: 1px dotted #ccc;
        padding-bottom: 10px;
    }
    span.annotation {
        color: #f00;
    }

    .error {
        border: solid 2px;
        border-color: red;
    }
    @media screen and (max-width: 480px) {
    /* 480px以下に適用されるCSS（スマホ用） */
        div.row {
            display: block;
        }
        div.col-4 {
            width: auto;
        }
        div.working_time {
            display: flex;
        }
    }
    @media screen and (min-width: 768px) {
        /* 768px以上に適用されるCSS（PC用） */
