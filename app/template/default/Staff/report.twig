    div.block_payment_advance {
        display: none;
    }
    div.block_payment_receipt {
        display: none;
    }
</style>
{% endblock stylesheet %}

{% block javascript %}
    <script src="//yubinbango.github.io/yubinbango/yubinbango.js" charset="UTF-8"></script>
    <script>
        // 業務報告
        $(function() {
            $('#working_time_total_disp').text('0:00');
            // 合計時間を算出
            $('#working_time_start_hour').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_start_minute').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_end_hour').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_end_minute').on('change', function() {
                working_time_total_calc();
            });
            $('#working_time_break').on('change', function() {
                working_time_total_calc();
            });
            // 未精算がある場合
            $('#payment').on('change', function() {
                var checked = $(this).prop('checked');
                if (checked) {
                    //$('input[id^="check_"]').prop('checked', true);
                    $('.block_payment_advance').show();
                    $('.block_payment_receipt').show();
                    //$('.block_payment_advance').css('display', 'flex');
                    //$('.block_payment_receipt').css('display', 'flex');
                } else {
                    //$('input[id^="check_"]').prop('checked', false);
                    $('.block_payment_advance').hide();
                    $('.block_payment_receipt').hide();
                }
            });
            // バリデーション
            $('#form1').on('submit', function() {
                if ( $('#Business').val() == '' ){
                    $('#Business').addClass('error');
                    $('#Business').focus();
                    return false;
                }
            });
            $('#Business').on('click', function() {
                $('#Business').removeClass('error');
            });

        });
        // 合計時間
        function working_time_total_calc(){
            var timetotal = '00:00';
            if(
                !$('#working_time_start_hour').length
                || !$('#working_time_start_minute').length
                || !$('#working_time_end_hour').length
                || !$('#working_time_end_minute').length
                || !$('#working_time_break').length
            ){
            }else{
                const tday = "2024/01/01";
                const starttime = $('#working_time_start_hour').val() + ':' + $('#working_time_start_minute').val();
                const endtime = $('#working_time_end_hour').val() + ':' + $('#working_time_end_minute').val();
                const breakminute = $('#working_time_break').val();
                const breaktime = `${Math.floor(breakminute / 60)}:${ breakminute % 60 }`;

                let date1 = new Date(`${tday} ${starttime}`);
                let date2 = new Date(`${tday} ${endtime}`);
                let date3 = breakminute * 60000;
                let ms = date2 - date1 - date3;
//                var diff = date2.getTime() - date1.getTime();
//                console.log(diff / (60*60*1000)); // 48
                if ( ms < 0 ){ return; }

                const hour = Math.floor(ms / 3600000);
                const minute = Math.floor((ms - 3600000 * hour) / 60000);
                const hh = ("00" + hour).slice(-2);
                const mm = ("00" + minute).slice(-2);
                timetotal = hh + ':' + mm;
            }
            $('#working_time_total').val(timetotal);
            $('#working_time_total_disp').text(timetotal);
        }
    </script>
{% endblock javascript %}

