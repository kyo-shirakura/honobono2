            </div>
        </div>
        <div class="ec-role ec-orderRole breadcrumbs">
            <div class="ec-orderRole__detail">
                <a href="/staff/menu" class="ec-inlineBtn ec-font-bold"><< TOPに戻る</a>
            </div>
        </div>
    </div>
{% endblock %}
