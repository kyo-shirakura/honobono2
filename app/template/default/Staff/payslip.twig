{##}

{% extends 'default_frame.twig' %}

{% set body_class = 'staff_payslip' %}

{% block stylesheet %}
    <style type="text/css">
        table td {
            background: #eee;
            padding: 10px;
        }
        table tr:nth-child(odd) td {
            background: #fff;
        }
        .breadcrumbs {
            margin-top:50px;
        }
    </style>
{% endblock stylesheet %}

{% block main %}
    <div class="ec-layoutRole__main">
        <div class="ec-mypageRole">
            <div class="ec-pageHeader">
                <h1>給与明細</h1>
            </div>
        </div>

        <div class="ec-orderRole">
            <div class="ec-orderRole__detail">
                <table>
                    <tr>
                        <td>2025年6月</td>
