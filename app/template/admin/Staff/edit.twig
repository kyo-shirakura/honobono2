                                                <div class="row justify-content-md-center pb-4">
                                                    {% include "@admin/pager.twig" with { 'id':Staff.id, 'pages' : pagination.paginationData, 'routes' : 'admin_staff_edit' } %}
                                                </div>
                                            {% endif %}
                                    </div>
                                {% else %}
                                    <div class="card-body">
                                        <div id="history_box" class="data-empty">
                                        <span>
                                            {{ 'admin.staff.no_history'|trans }}
                                        </span>
                                        </div>
                                    </div>
                                {% endif %}
#}
                                <div class="card-body">
                                    <div id="history_box" class="data-empty">
                                    <span>
                                        {{ 'admin.staff.no_history'|trans }}
                                    </span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    {% endif %}

                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="{{ 'tooltip.staff.shop_memo'|trans }}">
                                        <span class="card-title">{{ 'admin.common.shop_memo'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-bs-toggle="collapse" href="#shopMemo" aria-expanded="false"
                                       aria-controls="shopMemo">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="shopMemo">
                            <div class="card-body">
                                {{ form_widget(form.note, { 'attr': { 'row': 8 }}) }}
                                {{ form_errors(form.note) }}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink"
                               href="{{ url('admin_staff_page', { page_no : app.session.get('eccube.admin.staff.search.page_no')|default('1') } ) }}?resume=1">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'admin.staff.list'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5"
                                        type="submit">{{ 'admin.common.registration'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>
{% endblock %}
