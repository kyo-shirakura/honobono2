{% extends '@admin/default_frame.twig' %}

{% set menus = ['payslip', 'payslip_edit'] %}

{% block title %}{{ 'admin.payslip.registration'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.payslip.management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block main %}
    <form method="post" name="payslip_form" role="form" id="payslip_form" class="h-adr"
          action="{%- if Payslip.id %}{{ url('admin_payslip_edit', { id : Payslip.id }) }}{% else %}{{ url('admin_payslip_new') }}{% endif -%}"
          enctype="multipart/form-data" novalidate>

        <span class="p-country-name" style="display:none;">Japan</span>
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8"><span class="card-title">{{ 'admin.payslip.info'|trans }}</span>
                                </div>
                                <div class="col-4 text-right">
                                    <a data-toggle="collapse" href="#ordererInfo"
                                       aria-expanded="false" aria-controls="ordererInfo">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="ordererInfo">
                            <div class="card-body">
                                {% if Payslip.id %}
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.payslip.id'|trans }}</span>
                                    </div>
                                    <div class="col">
                                        <p>{{ Payslip.id }}</p>
                                    </div>
                                </div>
                                {% endif %}

                                {# エンティティ拡張の自動出力 #}
                                {% for f in form|filter(f => f.vars.eccube_form_options.auto_render) %}
                                    {% if f.vars.eccube_form_options.form_theme %}
                                        {% form_theme f f.vars.eccube_form_options.form_theme %}
                                        {{ form_row(f) }}
                                    {% else %}
                                        <div class="row mb-2">
                                            <div class="col-3">
                                                <span>{{ f.vars.label|trans }}</span>
                                            </div>
                                            <div class="col-3">
                                                {{ form_widget(f) }}
                                                {{ form_errors(f) }}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.payslip.issue_ym'|trans }}</span>
                                    </div>
                                    <div class="col-3">
                                        {{ form_widget(form.issue_ym) }}
                                        {{ form_errors(form.issue_ym) }}
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-3">
                                        <span>{{ 'admin.payslip.pdf_file'|trans }}</span>
                                    </div>
                                    <div class="col mb-2">
                                    {{ form_widget(form.file, { 'attr': { 'accept' : 'application/pdf' } }) }}
                                    {{ form_errors(form.file) }}
{#
                                        <div class="c-form__fileUploadThumbnail" style="background-image:url('{{ asset(Payslip.pdf_file|no_image_product, 'save_image') }}');"><a class="delete-image"><i class="fa fa-times" aria-hidden="true"></i></a></div>
                                        <div id="upload-zone" class="media py-5 border-ec-dashed mb-2 rounded">
                                            <div class="media-body">
                                                <i class="fa fa-cloud-upload fa-3x text-ec-lightGray mx-3 align-middle" aria-hidden="true"></i>
                                                {{ 'admin.common.drag_and_drop_pdf_description'|trans }}
                                                {{ form_widget(form.file, { attr : { accept : 'application/pdf', 'data-trigger': 'change', 'class': 'form-control', style : 'display:none;' } }) }}
                                                {{ form_errors(form.file) }}
                                                {{ form_widget(form.pdf_file) }}
                                                {{ form_errors(form.pdf_file) }}
                                                <a class="btn btn-ec-regular mr-2" onclick="$('#{{form.file.vars.id}}').click()">
                                                    {{ 'admin.common.file_select'|trans }}
                                                </a>
                                            </div>
                                        </div>
#}
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col mb-2">
                                        {{ form_widget(form.sendmail) }}
                                    </div>
                                </div>
{#
                                <div class="row">
                                    <div class="col-3">
                                        <span>{{ 'admin.payslip.pdf_file'|trans }}</span>
                                    </div>
                                    <div class="col mb-2">
                                        <div id="upload-zone" class="media py-5 border-ec-dashed mb-2 rounded">
                                            <div class="media-body">
                                                <i class="fa fa-cloud-upload fa-3x text-ec-lightGray mx-3 align-middle" aria-hidden="true"></i>
                                                {{ 'admin.common.drag_and_drop_pdf_description'|trans }}
                                                {{ form_widget(form.file, { attr : { accept : 'pdf/*', 'data-trigger': 'change', 'class': 'form-control', style : 'display:none;' } }) }}
                                                {{ form_errors(form.file) }}
                                                {{ form_widget(form.pdf_file) }}
                                                {{ form_errors(form.pdf_file) }}
                                                <a class="btn btn-ec-regular mr-2" onclick="$('#{{form.file.vars.id}}').click()">
                                                    {{ 'admin.common.file_select'|trans }}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
#}
                            </div>
                        </div>
                    </div>

                    {% if Payslip.id %}
<!--
                        <div class="card rounded border-0 mb-4">
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="d-inline-block" data-tooltip="true" data-placement="top"
                                             title="{{ 'tooltip.payslip.address'|trans }}">
                                        <span class="card-title">
                                            {{ 'admin.payslip.address'|trans }}

                                        </span>
                                        </div>
                                    </div>
                                    <div class="col-4 text-right">
                                        <a data-toggle="collapse" href="#delivery" aria-expanded="false"
                                           aria-controls="delivery">
                                            <i class="fa fa-angle-up fa-lg"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
-->
                    {% endif %}

                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink"
                               href="{{ url('admin_payslip_page', { page_no : app.session.get('eccube.admin.payslip.search.page_no')|default('1') } ) }}?resume=1">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'admin.payslip.list'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5"
                                        type="submit">{{ 'admin.common.registration'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
