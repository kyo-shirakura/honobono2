{% extends '@admin/default_frame.twig' %}
{% set menus = ['config', 'config_cancel'] %}

{% block title %}{{ 'admin.business_plan.cancel'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.business_plan.management'|trans }}{% endblock %}


{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/tempusdominus-bootstrap-4.min.css', 'admin') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/select2.min.css', 'admin') }}">

    <style type="text/css">
        .datepicker-days th.dow:first-child,
        .datepicker-days td:first-child {
            color: #f00;
        }

        .datepicker-days th.dow:last-child,
        .datepicker-days td:last-child {
            color: #00f;
        }
        .image_size_s{
            height: 25px;
        }
        .bold{
            font-weight: bold;
        }
        table#search_result > :not(caption) > tr > td {
            box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, #dddddd))!important;
        }
        table#search_result > :not(caption) > tr.on > td {
            box-shadow: inset 0 0 0 9999px var(--bs-table-bg-state, var(--bs-table-bg-type, #ffffff))!important;
        }
    </style>
{% endblock stylesheet %}

{% block main %}
    <!-- 料率設定 -->
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-8"><span class="card-title bold">{{ 'admin.common.mark'|trans }} {{ 'admin.business_plan.contractor.percentage'|trans }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card rounded config-0 mb-4 d-block">
                    <div class="card-body p-0">
                        <table class="table table-sm" id="search_result">
                            <thead>
                            <tr>
                                <th class="config-top-0 pt-2 pb-2 text-center">{{ 'admin.business_plan.cancel.name'|trans }}</th>
                                <th class="config-top-0 pt-2 pb-2 text-center">{{ 'admin.business_plan.cancel.customer_rate'|trans }}</th>
                                <th class="config-top-0 pt-2 pb-2 text-center">{{ 'admin.business_plan.cancel.staff_rate'|trans }}</th>
                                <th class="config-top-0 pt-2 pb-2 text-center pr-3"></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% set class_status = '' %}
                            {% for item in CancelKind %}
                                {% if class_status == '' %}
                                    {% set class_status = 'on' %}
                                {% else %}
                                    {% set class_status = '' %}
                                {% endif %}

                                <tr class='{{ class_status }}'>
                                    <td class="align-middle text-left"><a class="action-edit" href="{{ url('admin_business_plan_cancel_edit', { id : item.id }) }}">{{ item.name }}</a></td>
                                    <td class="align-middle text-left">{{ item.customer_rate }} ％ {% if item.customer_fare == 1 %}＋交通費{% endif %}</td>
                                    <td class="align-middle text-left">{{ item.staff_rate }} ％ {% if item.customer_fare == 1 %}＋交通費{% endif %}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <div class="row justify-content-md-center"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>

{% endblock %}
