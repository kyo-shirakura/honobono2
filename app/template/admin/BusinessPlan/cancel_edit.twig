{% extends '@admin/default_frame.twig' %}
{% set menus = ['config', 'config_cancel'] %}

{% block title %}{{ 'admin.business_plan.cancel'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.business_plan.management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    <style type="text/css">
        div.form-multi {
            display: flex;
        }
        div.form-multi > div {
            margin-right: 20px;
        }
        .w100 {
            width: 100px;
        }
    </style>
{% endblock stylesheet %}

{% block main %}
    <form name="config_cancel_form" role="form" id="config_cancel_form" method="post" class="h-adr"
      action="{%- if CancelKind.id %}{{ url('admin_business_plan_cancel_edit', { id : CancelKind.id }) }}{% else %}{{ url('admin_business_plan_cancel_new') }}{% endif -%}"
      novalidate>
        <span class="p-country-name" style="display:none;">Japan</span>
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8"><span class="card-title">{{ 'admin.business_plan.fee.list'|trans }}</span>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-toggle="collapse" href="#ordererInfo"
                                       aria-expanded="false" aria-controls="ordererInfo">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="ordererInfo">
                            <div class="card-body">

                                {# エンティティ拡張の自動出力 #}
                                {% for f in form|filter(f => f.vars.eccube_form_options.auto_render) %}
                                    {% if f.vars.eccube_form_options.form_theme %}
                                        {% form_theme f f.vars.eccube_form_options.form_theme %}
                                        {{ form_row(f) }}
                                    {% else %}
                                        <div class="row mb-2">
                                            <div class="col-3">
                                                <span>{{ f.vars.label|trans }}</span>
                                            </div>
                                            <div class="col-3">
                                                {{ form_widget(f) }}
                                                {{ form_errors(f) }}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}

                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.business_plan.cancel.name'|trans }}</span>
                                    </div>
                                    <div class="col-8">
                                        {{ form_widget(form.name) }}
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.business_plan.cancel.customer_rate'|trans }}</span>
                                    </div>
                                    <div class="col-2 form-multi">
                                        {{ form_widget(form.customer_rate, { 'type':'number', 'attr':{'class': 'w100'} }) }}{{ 'admin.common.percent'|trans }}
                                    </div>
                                    <div class="col-3">
                                        {{ form_widget(form.customer_fare) }}
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.business_plan.cancel.staff_rate'|trans }}</span>
                                    </div>
                                    <div class="col-2 form-multi">
                                        {{ form_widget(form.staff_rate, { 'type' : 'number', 'attr':{'class': 'w100'} }) }}{{ 'admin.common.percent'|trans }}
                                    </div>
                                    <div class="col-3">
                                        {{ form_widget(form.staff_fare) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink"
                               href="{{ url('admin_business_plan_cancel', { page_no : app.session.get('eccube.admin.business_plan.search.page_no')|default('1') } ) }}?resume=1">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'admin.business_plan.cancel'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5"
                                        type="submit">{{ 'admin.common.registration'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>
{% endblock %}
