{% extends '@admin/default_frame.twig' %}
{% set menus = ['config', 'main_bank'] %}

{% block title %}{{ 'admin.business_plan.cancel'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.business_plan.management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    <style type="text/css">
        div.form-multi {
            display: flex;
        }
        div.form-multi > div {
            margin-right: 20px;
        }
        .w100 {
            width: 100px;
        }
    </style>
{% endblock stylesheet %}

{% block main %}
    <form name="main_bank_form" role="form" id="main_bank_form" method="post" class="h-adr"
      action="{{ url('admin_main_bank') }}"
      novalidate>
        <span class="p-country-name" style="display:none;">Japan</span>
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8"><span class="card-title">{{ 'common.bank.invoice'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="ordererInfo">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.staff.transferee_account'|trans }}</span>
                                    </div>
                                    <div class="col">
                                    <div class="mb-3">
                                        <div class="row justify-content-start">
                                            <div class="col-auto pe-0 align-self-center"><span>{{ 'common.reg.code.invoice'|trans }}</span></div>
                                            <div class="col-4">
                                                {{ form_widget(form.invoice_reg_code) }}
                                                {{ form_errors(form.invoice_reg_code) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="row justify-content-start">
                                            <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.name'|trans }}</span></div>
                                            <div class="col-4">
                                                {{ form_widget(form.invoice_bank_name) }}
                                                {{ form_errors(form.invoice_bank_name) }}
                                            </div>
                                            <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.code'|trans }}</span></div>
                                            <div class="col-4">
                                                {{ form_widget(form.invoice_bank_code) }}
                                                {{ form_errors(form.invoice_bank_code) }}
                                            </div>
                                        </div>
                                    </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.branch.name'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.invoice_bank_branch_name) }}
                                                    {{ form_errors(form.invoice_bank_branch_name) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.branch.code'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.invoice_bank_branch_code) }}
                                                    {{ form_errors(form.invoice_bank_branch_code) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.type'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.invoice_bank_account_type, {'attr': {'class': 'form-multi'}}) }}
                                                    {{ form_errors(form.invoice_bank_account_type) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.number'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.invoice_bank_account_number) }}
                                                    {{ form_errors(form.invoice_bank_account_number) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.name'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.invoice_bank_account_name) }}
                                                    {{ form_errors(form.invoice_bank_account_name) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.name.kana'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.invoice_bank_account_name_kana) }}
                                                    {{ form_errors(form.invoice_bank_account_name_kana) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8"><span class="card-title">{{ 'common.bank.payslip'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="ordererInfo">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.staff.transferee_account'|trans }}</span>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.reg.code.payslip'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_reg_code) }}
                                                    {{ form_errors(form.payslip_reg_code) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.name'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_name) }}
                                                    {{ form_errors(form.payslip_bank_name) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.code'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_code) }}
                                                    {{ form_errors(form.payslip_bank_code) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.branch.name'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_branch_name) }}
                                                    {{ form_errors(form.payslip_bank_branch_name) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.branch.code'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_branch_code) }}
                                                    {{ form_errors(form.payslip_bank_branch_code) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.type'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_account_type, {'attr': {'class': 'form-multi'}}) }}
                                                    {{ form_errors(form.payslip_bank_account_type) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.number'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_account_number) }}
                                                    {{ form_errors(form.payslip_bank_account_number) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.name'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_account_name) }}
                                                    {{ form_errors(form.payslip_bank_account_name) }}
                                                </div>
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'common.bank.account.name.kana'|trans }}</span></div>
                                                <div class="col-4">
                                                    {{ form_widget(form.payslip_bank_account_name_kana) }}
                                                    {{ form_errors(form.payslip_bank_account_name_kana) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink"
                               href="{{ url('admin_business_plan_cancel', { page_no : app.session.get('eccube.admin.business_plan.search.page_no')|default('1') } ) }}?resume=1">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'admin.business_plan.cancel'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5"
                                        type="submit">{{ 'admin.common.registration'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>
{% endblock %}
