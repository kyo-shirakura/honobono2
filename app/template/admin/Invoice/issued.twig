{% extends '@admin/default_frame.twig' %}
{% set menus = ['invoice', 'invoice_master'] %}

{% block title %}{{ 'admin.invoice.issue.list'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.invoice.management'|trans }}{% endblock %}

{% form_theme searchForm '@admin/Form/bootstrap_4_layout.html.twig' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/select2.min.css', 'admin') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/tempusdominus-bootstrap-4.min.css', 'admin') }}">

{% endblock stylesheet %}

{% block javascript %}
    <script>
        $(function() {
            // 請求書アイコン
            $('.issue_view').on('click', function() {
                var id = $(this).data('id');

                const windowFeatures = "left=100,top=0,width=800,height=800";
                var win = window.open('{{ url('admin_homepage') }}invoice/'+id+'/issue/view', '_blank', windowFeatures);
                if (win) {
                    win.focus();
                }
            });
        });
    </script>
{% endblock javascript %}

{% block main %}
    <!--検索条件設定テーブルここから-->
    <div class="c-outsideBlock">
        <form name="search_form" id="search_form" method="POST" action="{{ url('admin_invoice') }}">
            <div class="c-outsideBlock__contents">
                <div class="row">
                    {{ form_widget(searchForm._token) }}
                    <div class="col-3">
                        <div>
                            <label class="col-form-label">{{ 'admin.customer.name'|trans }}</label>

                            <select id="admin_search_invoice_customer" name="admin_search_invoice[Customer]" class="form-select">
                                <option value="">選択してください</option>
                                {% for Customer in Customers %}
                                        <option value="{{ Customer.id }}"
                                        {% if Customer.id == searchCustomerID %} selected{% endif %}
                                        >{{ Customer.name01 }} {{ Customer.name02 }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="col-3">
                        <div>
                            <label class="col-form-label">{{ 'admin.invoice.issue_ym'|trans }}</label>
                            {{ form_widget(searchForm.issue_ym) }}
                            {{ form_errors(searchForm.issue_ym) }}
                        </div>
                    </div>
                </div>

                <div class="d-inline-block mb-3 collapsed" data-toggle="collapse" href="#searchDetail" aria-expanded="false" aria-controls="searchDetail">
                </div>
            </div>

            <div class="c-outsideBlock__contents">
                <div class="row">
                    <div class="mb-4">
                        <div class="col-12">
                            <button class="btn btn-ec-conversion px-5" type="submit" id="search_submit">{{ 'admin.common.search'|trans }}</button>
                            {% if pagination %}
                                <span class="font-weight-bold ml-2" id="search_total_count">{{ 'admin.common.search_result'|trans({"%count%":pagination.totalItemCount})|raw }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
<!--
            <div class="c-outsideBlock__contents mb-5">
                {{ include('@admin/search_items.twig', { 'form': searchForm }, ignore_missing = true) }}
            </div>
-->
        </form>
    </div>
    <!--検索条件設定テーブルここまで-->

    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                    <div class="row justify-content-between mb-2">
                        <div class="col-6"></div>

                        <div class="col-5 text-end">
                        <span>振替指定日：</span>
                            <div class="d-inline-block me-2 align-bottom">
                                <input type="date" id="print_invoice_issue_ym" name="print_invoice_issue_ym" class="form-control">
                            </div>

                            <div class="d-inline-block">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-ec-regular" href="{{ url('admin_customer_export') }}"><i class="fa fa-cloud-download me-1 text-secondary"></i><span>全銀データダウンロード</span></a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% if pagination and pagination.totalItemCount %}

                    <div class="card rounded binvoice-0 mb-4 d-block">
                        <div class="card-body p-0">
                            <table class="table table-sm" id="search_result">
                                <thead>
                                    <tr>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.issue_ym'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.customer'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.business.type'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.customer.payment_type'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.total'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.basic'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.overtime'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.advance'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.fare'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center pr-3"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for invoice in pagination %}
                                    <tr>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.issue_ym|date('Y年m月') }}
                                        </td>
                                        <td class="align-middle text-left">
                                            <a class="action-edit" href="{{ url('admin_customer_edit', { id : invoice.Customer.id }) }}">{{ invoice.Customer.name01 }} {{ invoice.Customer.name02 }}</a>
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.kind_id is empty ? '' : BusinessKinds[invoice.kind_id] }}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.Customer.payment_type is empty ? '' : PaymentType[invoice.Customer.payment_type] }}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.amount_total }}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.amount_basic }}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.amount_overtime }}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.amount_advance }}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {{ invoice.amount_fare }}
                                        </td>
<!--
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            <a class="action-edit" href="{{ url('admin_invoice_edit', { id : invoice.id }) }}">確認する</a>
                                        </td>
-->
                                        <td class="align-middle text-center">
                                            <button class="action-edit issue_view" data-id="{{ invoice.Customer.id }}"><i class="far fa-file-alt"></i></button>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                            <div class="row justify-content-md-center mb-4"></div>
                        </div>
                        <div class="row justify-content-md-center mb-4">
                            {% if pagination.totalItemCount > 0 %}
                                {% include "@admin/pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'admin_invoice_page' } %}
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="card rounded binvoice-0">
                        <div class="card-body p-4">
                            <div class="text-center text-muted mb-4 h5">{{ 'admin.common.search_no_result'|trans }}</div>
                            <div class="text-center text-muted">{{ 'admin.common.search_try_change_condition'|trans }}</div>
                            <div class="text-center text-muted">{{ 'admin.common.search_try_advanced_search'|trans }}</div>
                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>

{% endblock %}
