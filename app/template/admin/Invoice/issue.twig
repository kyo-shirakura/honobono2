    <!--検索条件設定テーブルここまで-->

    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                {% if pagination and pagination.totalItemCount %}

                    <div class="card rounded invoice-0 mb-4 d-block">
                        <div class="card-body p-0">
                            <table class="table table-sm" id="search_result">
                                <thead>
                                    <tr>
{#
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.issue_ym'|trans }}</th>
#}
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.customer'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.business.type'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.customer.payment_type'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.total'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.basic'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.overtime'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.advance'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center">{{ 'admin.invoice.detail.amout.fare'|trans }}</th>
                                        <th class="binvoice-top-0 pt-2 pb-2 text-center pr-3"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for invoice in pagination %}
                                    <tr>
{#
                                        <td class="align-middle text-center">
                                            {{ invoice.working_day }}
                                        </td>
#}
                                        <td class="align-middle text-left left20">
                                            <a class="action-edit" href="{{ url('admin_customer_edit', { id : invoice.Customer.id }) }}">{{ invoice.Customer.name01 }} {{ invoice.Customer.name02 }}</a>
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {% if invoice.Business.kind_id %}{{ BusinessKind[invoice.Business.kind_id] }}{% endif %}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                            {% if invoice.Customer.payment_type %}{{ PaymentType[invoice.Customer.payment_type] }}{% endif %}
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                        </td>
                                        <td class="align-middle text-center" style="white-space:nowrap">
                                        </td>
                                        <td class="align-middle text-center">
{#
                                            <a class="action-edit" href="{{ url('admin_invoice_issue_do', { id : invoice.Customer.id }) }}">{{ 'admin.invoice.issue.do'|trans }}</a>
#}
                                            <a class="action-edit" href="{{ url('admin_invoice_issue_edit', { id : invoice.Customer.id }) }}">{{ 'admin.invoice.issue.do'|trans }}</a>

                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                            <div class="row justify-content-md-center mb-4"></div>
                        </div>
                        <div class="row justify-content-md-center mb-4">
                            {% if pagination.totalItemCount > 0 %}
                                {% include "@admin/pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'admin_invoice_page' } %}
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="card rounded invoice-0">
                        <div class="card-body p-4">
                            <div class="text-center text-muted mb-4 h5">{{ 'admin.common.search_no_result'|trans }}</div>
                            <div class="text-center text-muted">{{ 'admin.common.search_try_change_condition'|trans }}</div>
                            <div class="text-center text-muted">{{ 'admin.common.search_try_advanced_search'|trans }}</div>
                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>

{% endblock %}
